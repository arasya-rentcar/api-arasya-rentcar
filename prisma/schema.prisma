generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  DRIVER
}

enum DriverStatus {
  AVAILABLE
  ON_DUTY
  OFF
}

enum DriverType {
  INTERNAL
  EXTERNAL
}

enum CarStatus {
  AVAILABLE
  IN_USE
  MAINTENANCE
}

enum OrderStatus {
  CREATED
  ASSIGNED
  IN_PROGRESS
  DONE
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  DP_PAID
  PAID
}

enum ExpenseType {
  FUEL
  TOLL
  PARKING
  OTHER
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  REVISED
  PAID
  CANCELLED
}

enum InvoiceType {
  DP
  SETTLEMENT
  FULL
  ADDITIONAL
  COMBINED
  CANCELLATION_FEE
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  QRIS
  OTHER
}

enum OrderSource {
  WEB
  WHATSAPP
  IMPORT
}

enum ScheduleStatus {
  SCHEDULED
  ASSIGNED
  IN_PROGRESS
  DONE
  CANCELLED
}

enum ReportInputType {
  TEXT
  IMAGE
  PDF
  DOCUMENT
  MIXED
}

enum ReportSource {
  WHATSAPP
  WEB
  API
}

enum ReportStatus {
  MATCHED
  UNMATCHED
  NEEDS_REVIEW
}

enum InvoiceDeliveryChannel {
  WHATSAPP
}

enum InvoiceDeliveryStatus {
  PENDING
  SENT
  FAILED
}

/// Which document a delivery log carried: the bill (INVOICE) or the
/// kwitansi/receipt (RECEIPT). Lets us send + audit both separately.
enum InvoiceDeliveryDocument {
  INVOICE
  RECEIPT
}

enum OrderAdjustmentType {
  ROUTE_CHANGE
  TIME_CHANGE
  EXTRA_DESTINATION
  OVERTIME
  PARKING
  TOLL
  FUEL
  DISCOUNT
  OTHER
}

model User {
  id         String   @id @default(uuid())
  email      String   @unique
  password   String
  role       Role
  created_at DateTime @default(now())
  driver     Driver?

  @@map("users")
}

model Driver {
  id             String             @id @default(uuid())
  user_id        String             @unique
  user           User               @relation(fields: [user_id], references: [id])
  name           String
  phone          String
  email          String?
  location       String?
  type           DriverType         @default(INTERNAL)
  status         DriverStatus       @default(AVAILABLE)
  reports        TripReport[]
  schedule_lines OrderServiceItem[]
  payables       Payable[]

  @@index([phone])
  @@index([type])
  @@map("drivers")
}

model Car {
  id              String             @id @default(uuid())
  plate_number    String             @unique
  unit_code       String?            @unique
  model           String
  status          CarStatus          @default(AVAILABLE)
  type            DriverType         @default(INTERNAL)
  origin_location String?
  photo_url       String?
  photos          String[]           @default([])
  schedule_lines  OrderServiceItem[]

  @@map("cars")
}

/// Global atomic counters (e.g. the running customer code C{n}).
/// Per-customer document sequences live on the Customer row, not here.
model Counter {
  scope      String   @id
  value      Int      @default(0)
  updated_at DateTime @updatedAt

  @@map("counters")
}

model Order {
  id                     String               @id @default(uuid())
  order_code             String?              @unique
  source                 OrderSource          @default(WEB)
  customer_name          String
  customer_phone         String
  pickup_location        String
  dropoff_location       String
  order_date             DateTime
  service_start_at       DateTime?
  service_end_at         DateTime?
  final_price            Decimal              @db.Decimal(12, 2)
  service_type           String?
  passenger_count        Int?
  notes                  String?
  area                   String?
  driver_origin          String?
  raw_order_text         String?
  whatsapp_message_id    String?
  driver_message_sent_at DateTime?
  customer_id            String?
  customer               Customer?            @relation(fields: [customer_id], references: [id], onDelete: SetNull)
  customer_seq           Int?
  paid_to_date           Decimal              @default(0) @db.Decimal(12, 2)
  is_external            Boolean              @default(false)
  external_vendor_id     String?
  external_vendor        ExternalVendor?      @relation(fields: [external_vendor_id], references: [id], onDelete: SetNull)
  external_car_id        String?
  external_car           ExternalCar?         @relation(fields: [external_car_id], references: [id], onDelete: SetNull)
  needs_review           Boolean              @default(false)
  review_reason          String?
  order_status           OrderStatus          @default(CREATED)
  // True once ALL active (non-cancelled) service lines are DONE but the admin
  // has not yet finalized the order. order_status stays IN_PROGRESS underneath;
  // this flag is the searchable "needs finalization" signal. Cleared on
  // finalize (order_status -> DONE).
  awaiting_finalization  Boolean              @default(false)
  payment_status         PaymentStatus        @default(UNPAID)
  is_final               Boolean              @default(false)
  invoice_missing        Boolean              @default(false)
  is_refunded            Boolean              @default(false)
  // Sprint 5: refund settlement record (proof REQUIRED to mark refunded).
  refunded_at            DateTime?
  refund_amount          Decimal?             @db.Decimal(12, 2)
  refund_proof_url       String?
  refund_note            String?
  created_at             DateTime             @default(now())
  updated_at             DateTime             @updatedAt
  customers              OrderCustomer[]
  service_items          OrderServiceItem[]
  reports                TripReport[]
  summary                OrderSummary?
  final_finance          OrderFinalFinance?
  sheet_import_rows      SheetImportRow[]
  invoices               Invoice[]
  invoice_delivery_logs  InvoiceDeliveryLog[]
  adjustments            OrderAdjustment[]
  change_logs            OrderChangeLog[]
  payables               Payable[]

  @@index([order_code])
  @@index([source])
  @@index([order_status])
  @@index([needs_review])
  @@index([awaiting_finalization])
  @@index([is_final])
  @@index([invoice_missing])
  @@index([is_refunded])
  @@index([service_start_at])
  @@index([service_end_at])
  @@index([customer_id])
  @@index([external_vendor_id])
  @@index([external_car_id])
  @@index([is_external])
  @@map("orders")
}

model Customer {
  id             String    @id @default(uuid())
  code           String    @unique
  name           String
  phone          String?   @unique
  email          String?
  tags           String[]  @default([])
  total_orders   Int       @default(0)
  total_spent    Decimal   @default(0) @db.Decimal(14, 2)
  total_billed   Decimal   @default(0) @db.Decimal(14, 2)
  total_paid     Decimal   @default(0) @db.Decimal(14, 2)
  order_seq      Int       @default(0)
  invoice_seq    Int       @default(0)
  kwitansi_seq   Int       @default(0)
  first_order_at DateTime?
  last_order_at  DateTime?
  notes          String?
  orders         Order[]
  receipts       Receipt[]
  created_at     DateTime  @default(now())
  updated_at     DateTime  @updatedAt

  @@index([phone])
  @@index([code])
  @@index([total_orders])
  @@map("customers")
}

model ExternalVendor {
  id             String             @id @default(uuid())
  name           String
  phone          String?
  notes          String?
  order_count    Int                @default(0)
  cars           ExternalCar[]
  orders         Order[]
  schedule_lines OrderServiceItem[]
  payables       Payable[]
  created_at     DateTime           @default(now())
  updated_at     DateTime           @updatedAt

  @@index([name])
  @@map("external_vendors")
}

model ExternalCar {
  id             String             @id @default(uuid())
  vendor_id      String
  vendor         ExternalVendor     @relation(fields: [vendor_id], references: [id], onDelete: Cascade)
  model          String
  plate_number   String?
  notes          String?
  orders         Order[]
  schedule_lines OrderServiceItem[]
  created_at     DateTime           @default(now())
  updated_at     DateTime           @updatedAt

  @@index([vendor_id])
  @@map("external_cars")
}

model OrderCustomer {
  id         String   @id @default(uuid())
  order_id   String
  order      Order    @relation(fields: [order_id], references: [id], onDelete: Cascade)
  name       String
  phone      String?
  is_primary Boolean  @default(false)
  created_at DateTime @default(now())

  @@index([order_id])
  @@map("order_customers")
}

model OrderServiceItem {
  id                     String    @id @default(uuid())
  order_id               String
  order                  Order     @relation(fields: [order_id], references: [id], onDelete: Cascade)
  service_date           DateTime?
  start_at               DateTime?
  end_at                 DateTime?
  description            String?
  service_kind           String?
  service_package        String?
  pickup_location        String
  dropoff_location       String
  driver_origin_location String?
  quantity               Int       @default(1)
  unit_price             Decimal   @default(0) @db.Decimal(12, 2)
  total_price            Decimal   @default(0) @db.Decimal(12, 2)
  notes                  String?
  sort_order             Int       @default(0)

  // --- Schedule / per-day assignment ---
  is_external        Boolean         @default(false)
  line_status        ScheduleStatus  @default(SCHEDULED)
  driver_id          String?
  driver             Driver?         @relation(fields: [driver_id], references: [id], onDelete: SetNull)
  car_id             String?
  car                Car?            @relation(fields: [car_id], references: [id], onDelete: SetNull)
  external_vendor_id String?
  external_vendor    ExternalVendor? @relation(fields: [external_vendor_id], references: [id], onDelete: SetNull)
  external_car_id    String?
  external_car       ExternalCar?    @relation(fields: [external_car_id], references: [id], onDelete: SetNull)
  driver_name_raw    String?
  plate_raw          String?

  // --- Per-day finance (daily margin = roll-up source) ---
  rtr_amount             Decimal? @db.Decimal(12, 2)
  ops_cost               Decimal  @default(0) @db.Decimal(12, 2)
  margin_amount          Decimal? @db.Decimal(12, 2)
  margin_formula_version String?

  payable Payable?

  // Merge: a service-day line owns its expenses + matched driver reports
  // (the line IS the trip). FKs moved off the dying order-level Trip model.
  expenses Expense[]
  reports  TripReport[]

  // --- Per-line trip journey (merged from the old order-level Trip model) ---
  // The line IS the trip. `line_status` (ScheduleStatus) is the single
  // per-line state (SCHEDULED/ASSIGNED/IN_PROGRESS/DONE/CANCELLED); these
  // timestamps record when the driver started / finished this day's service.
  // No separate trip_status: it would duplicate line_status 1:1.
  trip_started_at  DateTime?
  trip_finished_at DateTime?

  // --- Distinct ACTUAL operational timestamps (stamped by the WA bot from
  // driver reports). These are separate real-world events:
  //   actual_start_at  = driver DEPARTS the garage (starts driving to pickup)
  //   actual_pickup_at = driver ARRIVES at the customer pickup location
  //   (actual dropoff reuses trip_finished_at above)
  // finish_reported_at = when the driver reported finishing this line. The line
  // moves to DONE from the dropoff report, but the ORDER stays IN_PROGRESS
  // (awaiting admin finalization) regardless.
  actual_start_at    DateTime?
  actual_pickup_at   DateTime?
  finish_reported_at DateTime?

  // --- #A1/#A2 trip-confirmation messaging (additive, 2026-06-20) ---
  // confirmation_* = message sent to the CUSTOMER ("Data tim bertugas").
  // driver_reminder_* = message sent to the assigned DRIVER ("Reminder Jadwal").
  // *_snapshot stores { driver_id, car_id } captured at send time so we can
  // detect a later reassignment and flip the UI to "perlu kirim ulang".
  confirmation_sent_at      DateTime?
  confirmation_sent_snapshot Json?
  driver_reminder_sent_at    DateTime?
  driver_reminder_snapshot   Json?

  created_at DateTime @default(now())

  @@index([order_id])
  @@index([service_date])
  @@index([driver_id])
  @@index([car_id])
  @@index([external_vendor_id])
  @@index([line_status])
  @@map("order_service_items")
}

enum PayableKind {
  DRIVER
  VENDOR
}

enum PayableStatus {
  UNPAID
  PAID
}

/// Accounts payable: money Arasya owes OUT for a single service-day line.
/// DRIVER kind mirrors the "TAGIHAN DRIVER" sheet; VENDOR kind mirrors
/// "Tagihan Vendor". One payable per assigned service line.
model Payable {
  id     String        @id @default(uuid())
  kind   PayableKind
  status PayableStatus @default(UNPAID)

  service_item_id String           @unique
  service_item    OrderServiceItem @relation(fields: [service_item_id], references: [id], onDelete: Cascade)
  order_id        String
  order           Order            @relation(fields: [order_id], references: [id], onDelete: Cascade)

  driver_id String?
  driver    Driver?         @relation(fields: [driver_id], references: [id], onDelete: SetNull)
  vendor_id String?
  vendor    ExternalVendor? @relation(fields: [vendor_id], references: [id], onDelete: SetNull)

  service_date  DateTime?
  // FEE (driver) / HARGA (vendor): the base amount owed, synced from the line cost.
  base_amount   Decimal   @default(0) @db.Decimal(12, 2)
  // LAINNYA roll-up: sum of extras (overtime, meal, deductions). Can be negative.
  extras_amount Decimal   @default(0) @db.Decimal(12, 2)
  // base + extras = TOTAL owed.
  total_amount  Decimal   @default(0) @db.Decimal(12, 2)

  keterangan        String?
  paid_at           DateTime?
  payment_method    PaymentMethod?
  payment_proof_url String?

  extras PayableExtra[]

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([kind])
  @@index([status])
  @@index([driver_id])
  @@index([vendor_id])
  @@index([order_id])
  @@index([service_date])
  @@map("payables")
}

/// Itemized LAINNYA entries for a payable (overtime, meal, inap, deduction...).
model PayableExtra {
  id         String   @id @default(uuid())
  payable_id String
  payable    Payable  @relation(fields: [payable_id], references: [id], onDelete: Cascade)
  label      String
  amount     Decimal  @default(0) @db.Decimal(12, 2)
  created_at DateTime @default(now())

  @@index([payable_id])
  @@map("payable_extras")
}

model Invoice {
  id                String               @id @default(uuid())
  order_id          String
  order             Order                @relation(fields: [order_id], references: [id])
  invoice_number    String               @unique
  invoice_type      InvoiceType          @default(FULL)
  payment_method    PaymentMethod        @default(CASH)
  issue_date        DateTime             @default(now())
  due_date          DateTime?
  paid_at           DateTime?
  amount            Decimal              @db.Decimal(12, 2)
  note              String?
  file_url          String?
  receipt_url       String?
  payment_proof_url String?
  customer_seq      Int?
  status            InvoiceStatus        @default(ISSUED)
  revision          Int                  @default(0)
  parent_id         String?
  parent            Invoice?             @relation("InvoiceRevisions", fields: [parent_id], references: [id])
  revisions         Invoice[]            @relation("InvoiceRevisions")
  delivery_logs     InvoiceDeliveryLog[]
  receipts          Receipt[]
  created_at        DateTime             @default(now())
  updated_at        DateTime             @updatedAt

  @@index([order_id])
  @@index([parent_id])
  @@index([status])
  @@map("invoices")
}

/// Kwitansi / receipt. One invoice can have many receipts (e.g. partial
/// payments). Each receipt takes the customer's next running kwitansi number.
model Receipt {
  id                String        @id @default(uuid())
  receipt_number    String        @unique
  invoice_id        String
  invoice           Invoice       @relation(fields: [invoice_id], references: [id], onDelete: Cascade)
  customer_id       String
  customer          Customer      @relation(fields: [customer_id], references: [id])
  customer_seq      Int
  payment_date      DateTime      @default(now())
  amount            Decimal       @db.Decimal(12, 2)
  payment_method    PaymentMethod @default(CASH)
  payment_proof_url String?
  file_url          String?
  note              String?
  created_at        DateTime      @default(now())
  updated_at        DateTime      @updatedAt

  @@index([invoice_id])
  @@index([customer_id])
  @@map("receipts")
}

model InvoiceDeliveryLog {
  id                      String                 @id @default(uuid())
  invoice_id              String
  invoice                 Invoice                @relation(fields: [invoice_id], references: [id], onDelete: Cascade)
  order_id                String
  order                   Order                  @relation(fields: [order_id], references: [id], onDelete: Cascade)
  channel                 InvoiceDeliveryChannel  @default(WHATSAPP)
  document_type           InvoiceDeliveryDocument @default(INVOICE)
  target_name             String?
  target_phone            String
  message_text            String?
  file_url                String
  invoice_number_snapshot String
  amount_snapshot         Decimal                @db.Decimal(12, 2)
  status_snapshot         InvoiceStatus
  status                  InvoiceDeliveryStatus  @default(PENDING)
  provider_message_id     String?
  error_message           String?
  sent_by_user_id         String?
  sent_at                 DateTime?
  created_at              DateTime               @default(now())
  updated_at              DateTime               @updatedAt

  @@index([invoice_id])
  @@index([order_id])
  @@index([status])
  @@map("invoice_delivery_logs")
}

model OrderAdjustment {
  id          String              @id @default(uuid())
  order_id    String
  order       Order               @relation(fields: [order_id], references: [id], onDelete: Cascade)
  type        OrderAdjustmentType @default(OTHER)
  description String
  amount      Decimal             @default(0) @db.Decimal(12, 2)
  quantity    Int                 @default(1)
  is_billable Boolean             @default(true)
  created_by  String?
  created_at  DateTime            @default(now())

  @@index([order_id])
  @@index([type])
  @@map("order_adjustments")
}

model OrderChangeLog {
  id         String   @id @default(uuid())
  order_id   String
  order      Order    @relation(fields: [order_id], references: [id], onDelete: Cascade)
  field      String?
  old_value  String?
  new_value  String?
  note       String?
  actor      String?
  created_at DateTime @default(now())

  @@index([order_id])
  @@map("order_change_logs")
}

model Expense {
  id         String      @id @default(uuid())
  // Merge: expenses belong to a service-day line (the line IS the trip).
  order_service_item_id String?
  order_service_item    OrderServiceItem? @relation(fields: [order_service_item_id], references: [id], onDelete: Cascade)
  type       ExpenseType
  amount     Decimal     @db.Decimal(12, 2)
  note       String?
  created_at DateTime    @default(now())

  @@index([order_service_item_id])
  @@map("expenses")
}

model TripReport {
  id             String          @id @default(uuid())
  order_id       String?
  order          Order?          @relation(fields: [order_id], references: [id], onDelete: SetNull)
  // Merge: reports attach to a specific service-day line when matched.
  order_service_item_id String?
  order_service_item    OrderServiceItem? @relation(fields: [order_service_item_id], references: [id], onDelete: SetNull)
  order_code     String?
  driver_id      String?
  driver         Driver?         @relation(fields: [driver_id], references: [id], onDelete: SetNull)
  driver_phone   String?
  report_type    String
  input_type     ReportInputType @default(TEXT)
  notes          String?
  extracted_text String?
  file_url       String?
  file_mime      String?
  match_method   String?
  source         ReportSource    @default(WHATSAPP)
  status         ReportStatus    @default(MATCHED)
  created_at     DateTime        @default(now())

  @@index([order_id])
  @@index([order_service_item_id])
  @@index([order_code])
  @@index([driver_phone])
  @@index([report_type])
  @@index([status])
  @@map("trip_reports")
}

model OrderSummary {
  id                String   @id @default(uuid())
  order_id          String   @unique
  order             Order    @relation(fields: [order_id], references: [id], onDelete: Cascade)
  start_received    Boolean  @default(false)
  finish_received   Boolean  @default(false)
  docs_received     Int      @default(0)
  photos_count      Int      @default(0)
  missing_items     String[] @default([])
  e_toll_start      Decimal? @db.Decimal(12, 2)
  e_toll_used       Decimal? @db.Decimal(12, 2)
  e_toll_end        Decimal? @db.Decimal(12, 2)
  bbm_total         Decimal? @db.Decimal(12, 2)
  parking_total     Decimal? @db.Decimal(12, 2)
  odometer_start    Decimal? @db.Decimal(12, 2)
  odometer_finish   Decimal? @db.Decimal(12, 2)
  distance_km       Decimal? @db.Decimal(12, 2)
  fuel_liters       Decimal? @db.Decimal(12, 2)
  km_per_liter      Decimal? @db.Decimal(12, 2)
  generated_summary String?
  generated_at      DateTime @default(now())
  updated_at        DateTime @updatedAt

  @@map("order_summaries")
}

model OrderFinalFinance {
  id                      String    @id @default(uuid())
  order_id                String    @unique
  order                   Order     @relation(fields: [order_id], references: [id], onDelete: Cascade)
  sheet_checked_raw       String?
  refund_cashback_raw     String?
  refund_cashback_amount  Decimal?  @db.Decimal(12, 2)
  invoice_no_raw          String?
  service_date_raw        String?
  service_date            DateTime?
  vehicle_raw             String?
  route_raw               String?
  duration_raw            String?
  package_raw             String?
  driver_vendor_raw       String?
  plate_no_raw            String?
  sell_price              Decimal?  @db.Decimal(12, 2)
  rtr_amount              Decimal?  @db.Decimal(12, 2)
  dp_amount               Decimal?  @db.Decimal(12, 2)
  additional_amount       Decimal?  @db.Decimal(12, 2)
  user_overtime_amount    Decimal?  @db.Decimal(12, 2)
  user_overtime_hours_raw String?
  parking_user_amount     Decimal?  @db.Decimal(12, 2)
  total_user_amount       Decimal?  @db.Decimal(12, 2)
  paid_off_date_raw       String?
  paid_off_date           DateTime?
  fuel_amount             Decimal?  @db.Decimal(12, 2)
  toll_amount             Decimal?  @db.Decimal(12, 2)
  driver_fee_amount       Decimal?  @db.Decimal(12, 2)
  driver_overtime_amount  Decimal?  @db.Decimal(12, 2)
  parking_cash_amount     Decimal?  @db.Decimal(12, 2)
  other_amount            Decimal?  @db.Decimal(12, 2)
  finance_note            String?
  total_driver_amount     Decimal?  @db.Decimal(12, 2)
  driver_paid_date_raw    String?
  driver_paid_date        DateTime?
  total_ops_cost          Decimal?  @db.Decimal(12, 2)
  unit_rental_price       Decimal?  @db.Decimal(12, 2)
  margin_amount           Decimal?  @db.Decimal(12, 2)
  margin_formula_version  String?
  raw_row_json            Json?
  created_at              DateTime  @default(now())
  updated_at              DateTime  @updatedAt

  @@map("order_final_finances")
}

model SheetImportRow {
  id         String   @id @default(uuid())
  sheet_id   String
  gid        String
  row_number Int
  row_hash   String
  raw_json   Json
  order_id   String?
  order      Order?   @relation(fields: [order_id], references: [id], onDelete: SetNull)
  status     String
  warnings   String[] @default([])
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@unique([sheet_id, gid, row_number])
  @@index([status])
  @@index([order_id])
  @@map("sheet_import_rows")
}
