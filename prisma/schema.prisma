generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  DRIVER
}

enum DriverStatus {
  AVAILABLE
  ON_DUTY
  OFF
}

enum CarStatus {
  AVAILABLE
  IN_USE
  MAINTENANCE
}

enum OrderStatus {
  CREATED
  ASSIGNED
  IN_PROGRESS
  DONE
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  DP_PAID
  PAID
}

enum TripStatus {
  DRIVER_ASSIGNED
  DEPART_GARAGE
  ARRIVE_AT_CUSTOMER
  ON_TRIP
  DROP_CUSTOMER
  RETURN_GARAGE
  ARRIVE_GARAGE
  COMPLETED
}

enum Actor {
  ADMIN
  DRIVER
}

enum ExpenseType {
  FUEL
  TOLL
  PARKING
  OTHER
}

enum InvoiceStatus {
  ISSUED
  PAID
}

enum InvoiceType {
  DP
  SETTLEMENT
  FULL
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  QRIS
  OTHER
}

model User {
  id         String   @id @default(uuid())
  email      String   @unique
  password   String
  role       Role
  created_at DateTime @default(now())
  driver     Driver?

  @@map("users")
}

model Driver {
  id      String       @id @default(uuid())
  user_id String       @unique
  user    User         @relation(fields: [user_id], references: [id])
  name    String
  phone   String
  status  DriverStatus @default(AVAILABLE)
  trips   Trip[]

  @@map("drivers")
}

model Car {
  id           String    @id @default(uuid())
  plate_number String    @unique
  model        String
  status       CarStatus @default(AVAILABLE)
  trips        Trip[]

  @@map("cars")
}

model Order {
  id               String        @id @default(uuid())
  customer_name    String
  customer_phone   String
  pickup_location  String
  dropoff_location String
  order_date       DateTime
  final_price      Decimal       @db.Decimal(12, 2)
  order_status     OrderStatus   @default(CREATED)
  payment_status   PaymentStatus @default(UNPAID)
  created_at       DateTime      @default(now())
  updated_at       DateTime      @updatedAt
  trip             Trip?
  invoices         Invoice[]

  @@map("orders")
}

model Trip {
  id             String     @id @default(uuid())
  order_id       String     @unique
  order          Order      @relation(fields: [order_id], references: [id])
  driver_id      String
  driver         Driver     @relation(fields: [driver_id], references: [id])
  car_id         String
  car            Car        @relation(fields: [car_id], references: [id])
  current_status TripStatus @default(DRIVER_ASSIGNED)
  started_at     DateTime?
  finished_at    DateTime?
  created_at     DateTime   @default(now())
  logs           TripLog[]
  expenses       Expense[]

  @@map("trips")
}

model TripLog {
  id         String     @id @default(uuid())
  trip_id    String
  trip       Trip       @relation(fields: [trip_id], references: [id])
  status     TripStatus
  actor      Actor
  created_at DateTime   @default(now())

  @@map("trip_logs")
}

model Invoice {
  id             String        @id @default(uuid())
  order_id       String
  order          Order         @relation(fields: [order_id], references: [id])
  invoice_number String        @unique
  invoice_type   InvoiceType   @default(FULL)
  payment_method PaymentMethod @default(CASH)
  issue_date     DateTime      @default(now())
  amount         Decimal       @db.Decimal(12, 2)
  note           String?
  file_url       String?
  status         InvoiceStatus @default(ISSUED)
  created_at     DateTime      @default(now())

  @@map("invoices")
}

model Expense {
  id         String      @id @default(uuid())
  trip_id    String
  trip       Trip        @relation(fields: [trip_id], references: [id])
  type       ExpenseType
  amount     Decimal     @db.Decimal(12, 2)
  note       String?
  created_at DateTime    @default(now())

  @@map("expenses")
}
