/// Booking requests sent from the public website's booking form. The visitor
/// is sent on to WhatsApp with the same lead_code (ARS-XXXXX); the admin then
/// turns the lead into an order (or ignores it). Once the order's first
/// invoice is paid, a GA4 "purchase" is reported for the visitor who sent it.
enum WebLeadStatus {
  NEW
  CONVERTED
  IGNORED
}

model WebLead {
  id                     String        @id @default(uuid())
  lead_code              String        @unique
  status                 WebLeadStatus @default(NEW)
  name                   String
  trip_date              String?
  pickup_time            String?
  pickup_location        String
  destination            String?
  /// Map points picked on the website (2026-10-07): a side is stored only
  /// when both lat and lng were valid; place_id/name are the map provider's.
  pickup_lat             Float?
  pickup_lng             Float?
  pickup_place_id        String?
  pickup_place_name      String?
  destination_lat        Float?
  destination_lng        Float?
  destination_place_id   String?
  destination_place_name String?
  unit                   String?
  passenger_count        Int?
  duration               String?
  /// Website's duration choice: 12h | allin | oneway | return | multi.
  duration_key           String?
  notes                  String?
  page_path              String?
  language               String?
  campaign               String?
  gclid                  String?
  ga_client_id           String?
  ga_session_id          String?
  ignore_reason          String?
  order_id               String?       @unique
  order                  Order?        @relation(fields: [order_id], references: [id], onDelete: SetNull)
  purchase_reported_at   DateTime?
  created_at             DateTime      @default(now())
  updated_at             DateTime      @updatedAt

  @@index([status])
  @@index([created_at])
  @@map("web_leads")
}

/// Expo push tokens of the mobile app installs, one row per device. Used to
/// notify drivers (new trip, H-1 reminder) and admins (new website lead,
/// trip started/finished). Tokens Expo reports as unregistered are deleted.
/// Driver app inbox (2026-10-03): every push sent to a driver is also kept
/// here, so the app can list it (new trip, reassigned, reminder, order paid in
/// full, trip cost reviewed, fee paid) even when the push itself was missed.
model DriverNotification {
  id         String    @id @default(uuid())
  driver_id  String
  driver     Driver    @relation(fields: [driver_id], references: [id], onDelete: Cascade)
  type       String
  title      String
  body       String
  data       Json?
  read_at    DateTime?
  created_at DateTime  @default(now())

  @@index([driver_id, created_at])
  @@map("driver_notifications")
}

model DeviceToken {
  id           String   @id @default(uuid())
  user_id      String
  user         User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  token        String   @unique
  platform     String
  created_at   DateTime @default(now())
  last_seen_at DateTime @default(now())

  @@index([user_id])
  @@map("device_tokens")
}

enum DriverRequestType {
  ETOLL_TOPUP
}

enum DriverRequestStatus {
  OPEN
  DONE
  CANCELLED
}

/// Requests a driver sends from the app to the office (2026-10-04), e.g. an
/// e-toll top-up. Exactly-once on client_ref; at most one OPEN request per
/// driver and type. An admin marks it DONE (the driver gets a push + inbox row).
model DriverRequest {
  id           String              @id @default(uuid())
  driver_id    String
  driver       Driver              @relation(fields: [driver_id], references: [id], onDelete: Cascade)
  type         DriverRequestType
  card_label   String?
  // Card balance the driver reported, in rupiah.
  balance      Decimal?            @db.Decimal(12, 2)
  note         String?
  status       DriverRequestStatus @default(OPEN)
  client_ref   String              @unique
  created_at   DateTime            @default(now())
  handled_at   DateTime?
  // Admin user id that handled it.
  handled_by   String?
  handled_note String?
  // The office e-toll card it is about (2026-10-04). Old app versions only
  // send card_label; the admin picks the card when marking it done.
  card_id      String?
  card         EtollCard?          @relation(fields: [card_id], references: [id], onDelete: SetNull)
  transactions EtollTransaction[]

  @@index([driver_id, created_at])
  @@index([status, created_at])
  @@index([card_id, status])
  @@map("driver_requests")
}

enum EtollIssuer {
  MANDIRI // e-Money
  BCA // Flazz
  BRI // Brizzi
  BNI // TapCash
  DKI // JakCard
  OTHER
}

enum EtollCardStatus {
  ACTIVE
  INACTIVE
}

enum EtollTransactionType {
  TOPUP
  TOLL
  // Someone read the real balance on the card; the estimate restarts from it.
  BALANCE_CHECK
}

enum EtollTransactionSource {
  MANUAL
  NFC
}

/// Office e-toll cards (2026-10-04): a shared pool. A driver takes a card when
/// a trip starts and returns it when back at the garage (EtollCardHandover).
/// The real balance lives on the card's chip; balance here is an estimate: the
/// last known balance plus top-ups minus tolls since (recomputed from the
/// transactions), balance_at = when that last known balance was read.
model EtollCard {
  id              String              @id @default(uuid())
  issuer          EtollIssuer
  // Nickname drivers recognise, e.g. "Kartu 3".
  name            String
  // Digits only. Full number for the dashboard (top-up via m-banking); the
  // driver app only gets the last four.
  card_number     String              @unique
  balance         Decimal?            @db.Decimal(12, 2)
  balance_at      DateTime?
  status          EtollCardStatus     @default(ACTIVE)
  inactive_reason String?
  note            String?
  // Admin user id that added it.
  created_by      String?
  created_at      DateTime            @default(now())
  updated_at      DateTime            @updatedAt
  handovers       EtollCardHandover[]
  transactions    EtollTransaction[]
  requests        DriverRequest[]

  @@index([status])
  @@map("etoll_cards")
}

/// Who has which card. Open while returned_at is null; at most one open
/// handover per card (partial unique index in the migration). Taking a card
/// another driver still holds closes theirs (moved on without the garage).
model EtollCardHandover {
  id              String             @id @default(uuid())
  card_id         String
  card            EtollCard          @relation(fields: [card_id], references: [id])
  driver_id       String
  driver          Driver             @relation(fields: [driver_id], references: [id])
  // The trip it was taken for, when the driver took it from a trip.
  service_item_id String?
  taken_at        DateTime           @default(now())
  // Admin user id that recorded it; null = the driver in the app.
  taken_by        String?
  returned_at     DateTime?
  // Admin user id; null = the driver in the app (or another driver took it).
  returned_by     String?
  // RETURNED (back at the office) or TAKEN_OVER (another driver took it).
  return_kind     String?
  // Idempotency keys from the phone for "Ambil kartu" / "Kembalikan kartu".
  client_ref      String?            @unique
  return_ref      String?            @unique
  transactions    EtollTransaction[]

  @@index([card_id, taken_at])
  @@index([driver_id, returned_at])
  @@map("etoll_card_handovers")
}

/// Card history: top-ups, tolls and balance checks. Never edited: a wrong
/// entry is voided (voided_at) and entered again; the card balance follows.
model EtollTransaction {
  id              String                 @id @default(uuid())
  card_id         String
  card            EtollCard              @relation(fields: [card_id], references: [id])
  type            EtollTransactionType
  // Rupiah for TOPUP/TOLL; null for a balance check.
  amount          Decimal?               @db.Decimal(12, 2)
  // Balance on the card after this, when someone read it (always set for
  // BALANCE_CHECK).
  balance_after   Decimal?               @db.Decimal(12, 2)
  source          EtollTransactionSource @default(MANUAL)
  occurred_at     DateTime               @default(now())
  driver_id       String?
  driver          Driver?                @relation(fields: [driver_id], references: [id], onDelete: SetNull)
  request_id      String?
  request         DriverRequest?         @relation(fields: [request_id], references: [id], onDelete: SetNull)
  handover_id     String?
  handover        EtollCardHandover?     @relation(fields: [handover_id], references: [id], onDelete: SetNull)
  service_item_id String?
  note            String?
  // Admin user id; null = the driver app.
  created_by      String?
  client_ref      String?                @unique
  created_at      DateTime               @default(now())
  voided_at       DateTime?
  voided_by       String?
  void_reason     String?

  @@index([card_id, occurred_at])
  @@index([request_id])
  @@map("etoll_transactions")
}

/// Dashboard notification feed (2026-10-04): driver status changes, reports,
/// trip costs and driver requests. Written after the driver's action commits,
/// once per real change. Read state is per admin (AdminNotificationRead).
model AdminNotification {
  id                String                  @id @default(uuid())
  // TRIP_ACCEPTED | TRIP_STARTED | TRIP_ARRIVED | TRIP_BOARDED | TRIP_FINISHED
  // | TRIP_REPORT | TRIP_COST | DRIVER_REQUEST
  type              String
  title             String
  body              String
  order_id          String?
  order_code        String?
  service_item_id   String?
  driver_id         String?
  driver_request_id String?
  expense_id        String?
  // Dashboard path to open, e.g. "/dashboard/orders/<id>".
  link              String
  created_at        DateTime                @default(now())
  reads             AdminNotificationRead[]

  @@index([created_at])
  @@index([service_item_id])
  @@map("admin_notifications")
}

model AdminNotificationRead {
  id              String            @id @default(uuid())
  notification_id String
  notification    AdminNotification @relation(fields: [notification_id], references: [id], onDelete: Cascade)
  user_id         String
  user            User              @relation(fields: [user_id], references: [id], onDelete: Cascade)
  read_at         DateTime          @default(now())

  @@unique([notification_id, user_id])
  @@index([user_id])
  @@map("admin_notification_reads")
}

/// Official price list (2026-10-06): the website's prices, edited by the admin
/// in the dashboard. Cars are the website's fleet (Sanity slugs). Every edit is
/// logged (PriceChangeLog); the website only sees what was last published
/// (PricePublication), never the working copy.
model PriceCar {
  id          String      @id @default(uuid())
  // Website/Sanity car slug, e.g. "toyota-avanza".
  slug        String      @unique
  name        String
  // Price class shown to admins, e.g. "Avanza sekelas".
  price_class String?
  note        String?
  sort_order  Int         @default(0)
  created_at  DateTime    @default(now())
  updated_at  DateTime    @updatedAt
  rates       PriceRate[]

  @@map("price_cars")
}

/// One price table (2026-10-06): a package in an area, e.g. "All-in Jakarta".
model PriceZone {
  id                   String           @id @default(uuid())
  // Stable key the website uses, e.g. "JABODETABEK", "DROP_JABODETABEK".
  code                 String           @unique
  name                 String
  // Order-form vocabulary: "XOPS" (car + driver) or "ALL-IN X PARKIR" (all-in, drop).
  service_package      String
  included             String
  excluded             String
  note                 String?
  // The table for cities that have none of their own.
  default_for_unlisted Boolean          @default(false)
  sort_order           Int              @default(0)
  created_at           DateTime         @default(now())
  updated_at           DateTime         @updatedAt
  rates                PriceRate[]
  surcharges           PriceSurcharge[]
  driver_cities        PriceCity[]      @relation("PriceCityDriverZone")
  all_in_cities        PriceCity[]      @relation("PriceCityAllInZone")

  @@map("price_zones")
}

/// Price of one car in one table for one duration (2026-10-06).
model PriceRate {
  id          String    @id @default(uuid())
  zone_id     String
  zone        PriceZone @relation(fields: [zone_id], references: [id])
  car_id      String
  car         PriceCar  @relation(fields: [car_id], references: [id])
  // "12H" | "FULLDAY" | "DROP", same vocabulary as OrderServiceItem.service_kind.
  duration    String
  // Rupiah per car per day; null = "tanya admin".
  amount      Decimal?  @db.Decimal(12, 2)
  // Proposed by the team (marked (u) in the price list); the owner still has to confirm.
  is_proposal Boolean   @default(false)
  note        String?
  // Admin user id of the last change.
  updated_by  String?
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt

  @@unique([zone_id, car_id, duration])
  @@index([car_id])
  @@map("price_rates")
}

/// Extra charge when an all-in rental in a table's city also goes to an area
/// (2026-10-06), e.g. Jakarta to Bekasi +100.000.
model PriceSurcharge {
  id         String    @id @default(uuid())
  zone_id    String
  zone       PriceZone @relation(fields: [zone_id], references: [id])
  area       String
  amount     Decimal   @db.Decimal(12, 2)
  sort_order Int       @default(0)
  updated_by String?
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt

  @@unique([zone_id, area])
  @@map("price_surcharges")
}

/// Which tables a website city page shows (2026-10-06). Abroad cities are
/// "quote": priced per trip, no table.
model PriceCity {
  id             String     @id @default(uuid())
  // Website city slug, e.g. "sewa-mobil-bogor".
  slug           String     @unique
  name           String
  // Car + driver table and all-in table; both null when quote.
  driver_zone_id String?
  driver_zone    PriceZone? @relation("PriceCityDriverZone", fields: [driver_zone_id], references: [id])
  all_in_zone_id String?
  all_in_zone    PriceZone? @relation("PriceCityAllInZone", fields: [all_in_zone_id], references: [id])
  quote          Boolean    @default(false)
  sort_order     Int        @default(0)
  created_at     DateTime   @default(now())
  updated_at     DateTime   @updatedAt

  @@index([driver_zone_id])
  @@index([all_in_zone_id])
  @@map("price_cities")
}

/// Driver costs and overtime (2026-10-06): DRIVER_MEAL, DRIVER_LODGING,
/// OVERTIME. A fixed amount, or a percent (overtime: of the Fullday price).
model PriceExtra {
  id         String   @id @default(uuid())
  code       String   @unique
  label      String
  amount     Decimal? @db.Decimal(12, 2)
  percent    Decimal? @db.Decimal(5, 2)
  // "hari" | "malam" | "jam".
  unit       String
  note       String?
  updated_by String?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@map("price_extras")
}

/// Every change to the price list (2026-10-06), one row per field. Append-only.
model PriceChangeLog {
  id         String   @id @default(uuid())
  // rate | surcharge | extra | zone | city | car
  entity     String
  entity_id  String
  // The column, or "created" / "deleted" for a whole row.
  field      String
  old_value  String?
  new_value  String?
  // Admin user id.
  changed_by String?
  created_at DateTime @default(now())

  @@index([created_at])
  @@map("price_change_logs")
}

/// A published copy of the price list (2026-10-06): the snapshot the website
/// build reads from GET /public/prices (latest row). Append-only.
model PricePublication {
  id            String   @id @default(uuid())
  // json, not jsonb: keeps the key order (cars and durations in list order).
  snapshot      Json     @db.Json
  note          String?
  // Idempotency key from the dashboard: a resend returns the same row.
  client_ref    String?  @unique
  // Admin user id.
  published_by  String?
  // Website deploy hook: SENT | SKIPPED (no hook configured) | FAILED.
  deploy_status String
  created_at    DateTime @default(now())

  @@index([created_at])
  @@map("price_publications")
}
