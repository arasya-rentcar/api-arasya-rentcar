# /var/www/api-arasya-rentcar/shared/.env  (chmod 600; never commit the filled copy)
# Where each value comes from is in ops/README.md, "Env values".

NODE_ENV=production
# nginx (ops/nginx/api.haikuy.com.conf) proxies to this port. Not 3000: the dashboard uses it.
PORT=4000
TRUST_PROXY=1
LOG_LEVEL=info

# Supabase → Connect → "Session pooler" string (works without IPv6), with the database password
# (reset it there if unknown). DATABASE_URL = that string + "?connection_limit=5"; DIRECT_URL = the
# same string as is (used by `prisma migrate deploy`).
DATABASE_URL=
DIRECT_URL=

# New random value if the old one is lost: openssl rand -hex 32
# (changing it logs out every admin and driver once).
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Supabase → Project Settings → API: Project URL and the service_role key.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_STORAGE_BUCKET=invoices

# Required in production. The old WhatsApp bot is retired: any random value (openssl rand -hex 32).
BOT_INTERNAL_TOKEN=
WA_DELIVERY=manual

# Dashboard origins (comma separated). Add the Vercel copy's URL if admins use it.
CORS_ORIGINS=https://dashboard.haikuy.com
# Website origins allowed to send booking leads (empty = the built-in list: arasya-web.vercel.app, arasyarentcar.com, www.arasyarentcar.com).
PUBLIC_LEAD_ORIGINS=

# GA4 → Admin → Data streams → (web stream): Measurement ID, and Measurement Protocol API secrets → create.
GA4_MEASUREMENT_ID=
GA4_API_SECRET=

# Vercel → arasya-web project → Settings → Git → Deploy Hooks → create (secret URL). Empty = off.
WEB_DEPLOY_HOOK_URL=

# H-1 trip-team confirmation sweep (WIB) and driver/car status refresh.
CONFIRMATION_SWEEP_ENABLED=true
CONFIRMATION_SWEEP_TIME=17:00
RESOURCE_STATUS_REFRESH_ENABLED=true
