# Server
PORT=3000
NODE_ENV=development

# Database (PostgreSQL / Supabase)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public"

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRES_IN=7d

# Supabase Storage
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your_supabase_service_role_key
SUPABASE_STORAGE_BUCKET=invoices

BOT_INTERNAL_TOKEN=

# WhatsApp delivery: manual (default) = dashboard returns wa.me links + driver push;
# bot = send through the (retiring) wa-bot service at WA_BOT_INTERNAL_URL
WA_DELIVERY=manual
CORS_ORIGINS=
TRUST_PROXY=1
LOG_LEVEL=info

# Website booking-form leads (comma-separated origins allowed to POST /api/v1/public/leads)
PUBLIC_LEAD_ORIGINS=https://arasya-web.vercel.app,https://arasyarentcar.com,https://www.arasyarentcar.com

# GA4 Measurement Protocol: report "purchase" when a website lead's order is first paid
GA4_MEASUREMENT_ID=
GA4_API_SECRET=
